# Schwab developer app credentials (https://developer.schwab.com)
SCHWAB_CLIENT_ID=your-app-key
SCHWAB_CLIENT_SECRET=your-app-secret

# Must EXACTLY match the callback URL registered on your Schwab app.
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182/callback

# Plain-HTTP listener the MCP client connects to.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# HTTPS listener that only your browser hits during login.
CALLBACK_HOST=127.0.0.1
CALLBACK_PORT=8182

LOG_LEVEL=info
# TRADER_TOOLS=false   # Phase 2 opt-in
